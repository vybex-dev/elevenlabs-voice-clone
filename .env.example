# ElevenLabs API Key (Required for PVC Voice Cloning)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Administrator Credentials (Optional - defaults to admin / admin123)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminisbrokes

# Session Security Secret (Optional)
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# ==============================================================================
# Firebase Firestore Database Configuration (Production Cloud Database)
# ==============================================================================
# Option 1: Individual Service Account Variables (Recommended for Vercel / Cloud)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Option 2: Full Service Account JSON String
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

# Note: If Firebase credentials are not provided, the app will automatically
# use local persistent file storage in data/app_data.json.
